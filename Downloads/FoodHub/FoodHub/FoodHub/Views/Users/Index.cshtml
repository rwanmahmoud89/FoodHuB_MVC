@model IEnumerable<FoodHub.Models.User>
@{
ViewData["Title"] = "Users";
}   
<h2>Users</h2>

<table border="1">
    <thead>
        <tr>
            <th>Id</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone Number</th>
            <th>Address</th>
            <th>Role</th>
            <th>Created At</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@user.PhoneNumber</td>
                <td>@user.Address</td>
                <td>@user.Role</td>
                <td>@user.CreatedAt</td>
            </tr>
        }
    </tbody>
</table>


